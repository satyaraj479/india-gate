{
  "name": "india-gate",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @indiagate/database generate",
    "db:migrate": "pnpm --filter @indiagate/database migrate:dev",
    "db:seed": "pnpm --filter @indiagate/database seed",
    "api:codegen": "pnpm --filter @indiagate/contracts codegen",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml}\""
  },
  "devDependencies": {
    "@indiagate/eslint-config": "workspace:*",
    "@indiagate/tsconfig": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
