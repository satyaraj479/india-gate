# ---------------------------------------------------------------------------
# India Gate — web app
#
# Copy to .env.local. The app runs with none of these set: the bundled
# catalog serves the menu and cash-on-delivery completes an order end to end.
# Add the Stripe keys to exercise card payment.
# ---------------------------------------------------------------------------

# Canonical origin. Used for metadata, Open Graph and payment return URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Menu source -----------------------------------------------------------
# Leave BOTH unset to use the bundled catalog in src/lib/catalog/local-catalog.ts.
# Set both to read the menu from the NestJS platform API instead — no component
# changes, see src/lib/catalog/repository.ts.
# MENU_API_URL="http://localhost:4000/v1"
# NEXT_PUBLIC_OUTLET_ID=""

# --- Payments --------------------------------------------------------------
# "stripe" (default) or "razorpay".
PAYMENT_PROVIDER="stripe"

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen --forward-to localhost:3000/api/webhooks/payments`
STRIPE_WEBHOOK_SECRET=""

# Razorpay, only when PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# Signs the short-lived receipt cookie the confirmation page falls back to when
# the in-memory order store misses (which is most of the time on serverless).
# Any long random string. Generate one with: openssl rand -base64 32
RECEIPT_SECRET=""
