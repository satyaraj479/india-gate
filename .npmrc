# Metro (Expo's bundler) has historically resolved symlinked workspace
# packages inconsistently across versions. Hoisting sidesteps the whole class
# of "works on web, fails on device" bugs at the cost of some of pnpm's
# strictness. Revisit once Expo SDK's Metro resolver is stable on symlinks.
node-linker=hoisted

# Expo and React Native still ship a lot of packages with sloppy peer ranges.
strict-peer-dependencies=false
auto-install-peers=true

# Prisma downloads engine binaries on install; keep them out of the store
# churn on CI.
public-hoist-pattern[]=*prisma*
