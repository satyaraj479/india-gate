# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://indiagate:indiagate@localhost:5432/indiagate?schema=public&connection_limit=20"
# Direct (non-pooled) connection. Prisma Migrate needs this when the app runs
# through PgBouncer.
DIRECT_DATABASE_URL="postgresql://indiagate:indiagate@localhost:5432/indiagate?schema=public"
READ_REPLICA_URL=

# --- Redis (sessions, rate limits, BullMQ, socket adapter) ----------------
REDIS_URL="redis://localhost:6379"

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# --- Payments -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HITPAY_API_KEY=
HITPAY_WEBHOOK_SALT=

# --- Messaging ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXPO_ACCESS_TOKEN=

# --- Delivery -------------------------------------------------------------
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=

# --- Storage / CDN --------------------------------------------------------
S3_BUCKET=
S3_REGION=ap-southeast-1
CDN_BASE_URL="https://cdn.indiagate.sg"

# --- Clients --------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/v1"
NEXT_PUBLIC_RT_URL="ws://localhost:4000"
EXPO_PUBLIC_API_URL="http://localhost:4000/v1"
EXPO_PUBLIC_RT_URL="ws://localhost:4000"
