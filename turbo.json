{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "APP_ENV"],
  "tasks": {
    "//#format": { "cache": false },

    "db:generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["generated/**"]
    },

    "codegen": {
      "cache": true,
      "inputs": ["openapi.yaml", "src/schemas/**"],
      "outputs": ["src/generated/**"]
    },

    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "build/**"
      ],
      "env": ["DATABASE_URL", "NEXT_PUBLIC_*", "EXPO_PUBLIC_*"]
    },

    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },

    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "clean": { "cache": false }
  }
}
